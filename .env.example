# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon key: usata lato client da components/OverlayRecorder.jsx (upload
# registrazioni su Storage, insert su audio_overlays sotto RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — usato da /api/lyrics/generate per scrivere i testi
ANTHROPIC_API_KEY=

# kie.ai (Suno-compatible) — usato da /api/audio/generate e /api/audio/status/[id]
KIE_AI_API_KEY=
